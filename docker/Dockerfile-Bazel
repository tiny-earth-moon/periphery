FROM swift:6.4.2

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

ARG BAZELISK_VERSION=v1.30.0
ARG BAZELISK_SHA256=b2bcc040c213b44586b121bda6d983c35df121b917c3a7a66fb16f2fa0df1a4f
RUN curl -fsSLo /usr/local/bin/bazelisk "https://github.com/bazelbuild/bazelisk/releases/download/${BAZELISK_VERSION}/bazelisk-linux-arm64" \
    && echo "${BAZELISK_SHA256}  /usr/local/bin/bazelisk" | sha256sum -c - \
    && chmod +x /usr/local/bin/bazelisk \
    && ln -s /usr/local/bin/bazelisk /usr/local/bin/bazel

WORKDIR /workspace
COPY . /workspace

ENV CC=clang
RUN bazel build //:periphery

COPY docker/bazel-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
