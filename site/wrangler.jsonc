{
  "name": "outskirts-site",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build" },
  "assets": { "directory": "./public" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
